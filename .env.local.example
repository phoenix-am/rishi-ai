# Local environment variables overrides
# Copy this file to .env.local and make adjustments

NODE_ENV=development
PORT=3000

# Docker-backed PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rishi_ai

# Set your model provider
PRIMARY_AI_PROVIDER=gemini

# Generate a cryptographically secure 64-character key for local tests
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

GEMINI_API_KEY=AQ.Ab8RN6KeHArutn93RKyBE_tyRLRncvIJf5D9U_eYtjdbXqKBZw

# Enable detailed console logging
LOG_LEVEL=debug
