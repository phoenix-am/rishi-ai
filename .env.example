# System Environment
NODE_ENV=development
PORT=3000

# Relational Database Connection (PG + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rishi_ai

# Primary AI Provider Configuration (gemini, openai, deepseek, ollama)
PRIMARY_AI_PROVIDER=gemini

# Cryptographic Master Key (hex-encoded string of exactly 64 characters)
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

GEMINI_API_KEY=AQ.Ab8RN6KeHArutn93RKyBE_tyRLRncvIJf5D9U_eYtjdbXqKBZw

# Structured Logger Settings (error, warn, info, debug)
LOG_LEVEL=info

# JWT asymmetric key pair (base64 PEM RS256 keys)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
