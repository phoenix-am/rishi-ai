NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rishi_ai
AES_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_PRIVATE_KEY=replace_with_base64_encoded_rs256_private_key
JWT_PUBLIC_KEY=replace_with_base64_encoded_rs256_public_key
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIR=storage
QUEUE_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=2000
QUEUE_MAX_ATTEMPTS=25
QUEUE_SHUTDOWN_TIMEOUT_MS=15000
EMAIL_PROVIDER=disabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
SMTP_FROM=no-reply@example.com
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
AUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/auth/callback
AUTH_FAILURE_REDIRECT_URL=http://localhost:5173/login?error=oauth_failed
